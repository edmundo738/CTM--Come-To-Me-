extends Node

# Game rules emit semantic facts. This bus coordinates presentation only; it
# never advances a turn, changes board state, or waits for an animation.
signal event_emitted(event: String, context: Dictionary)

const EVENTS := {
	"MOVE": {"audio": "step", "haptic": "step"},
	"WAIT": {"haptic": "wait"},
	"BLOCKED": {"audio": "blocked", "haptic": "blocked"},
	"COIN_PICKUP": {"audio": "coin", "haptic": "coin"},
	"SHIELD_PICKUP": {"audio": "shield", "haptic": "shield"},
	"BREAKER_PICKUP": {"audio": "breaker", "haptic": "breaker"},
	"SHIELD_IMPACT": {"audio": "hit", "haptic": "shield_impact"},
	"ELITE_COUNTER": {"audio": "hit", "haptic": "elite_stagger"},
	"HIT": {"audio": "hit", "haptic": "hit"},
	"EXPLOSION": {"audio": "explosion", "haptic": "explosion"},
	"DEMOLITION": {"audio": "break_wall", "haptic": "break_wall"},
	"CAPTURE_START": {"audio": "inflate", "haptic": "inflate"},
	"CAPTURE_POP": {"audio": "balloon_pop", "haptic": "balloon_pop"},
	"PORTAL_OPEN": {"audio": "portal", "haptic": "portal"},
	"PORTAL_ENTER": {"audio": "portal", "haptic": "portal"},
	"SWITCH_ON": {"audio": "switch", "haptic": "switch"},
	"JUMP": {"audio": "jump", "haptic": "jump"},
	"BLINK": {"audio": "blink", "haptic": "blink"},
	"POWER_SPEED": {"audio": "power_speed", "haptic": "power_speed"},
	"POWER_MAGNET": {"audio": "power_magnet", "haptic": "power_magnet"},
	"POWER_BLINK": {"audio": "power_blink", "haptic": "power_blink"},
	"POWER_TIME_FREEZE": {"audio": "power_time_freeze", "haptic": "power_time_freeze"},
	"PUZZLE_ERROR": {"audio": "puzzle_error", "haptic": "puzzle_error"},
	"RHYTHM_TRAP": {"audio": "rhythm_trap", "haptic": "rhythm_trap"},
	"TURN_COMMITTED": {},
	"NEAR_MISS": {"audio": "near_miss", "haptic": "near_miss"},
	"ENEMY_NEAR": {"haptic": "heartbeat"},
}

# Compatibility for external callers of audio.play(), including muted audio.
# Audio generated by this bus is guarded so it is never dispatched twice.
const AUDIO_EVENTS := {
	"step": "MOVE", "blocked": "BLOCKED", "coin": "COIN_PICKUP",
	"shield": "SHIELD_PICKUP", "breaker": "BREAKER_PICKUP", "hit": "HIT",
	"explosion": "EXPLOSION", "break_wall": "DEMOLITION", "inflate": "CAPTURE_START",
	"balloon_pop": "CAPTURE_POP", "portal": "PORTAL_ENTER", "switch": "SWITCH_ON",
	"jump": "JUMP", "blink": "BLINK", "power_speed": "POWER_SPEED",
	"power_magnet": "POWER_MAGNET", "power_blink": "POWER_BLINK",
	"power_time_freeze": "POWER_TIME_FREEZE", "puzzle_error": "PUZZLE_ERROR",
	"rhythm_trap": "RHYTHM_TRAP", "near_miss": "NEAR_MISS",
}

var audio: Node
var controller: Node
var playing_bus_audio := false
var heartbeat_cooldown := 0.0
var near_miss_cooldown := 0.0
var threat_active := false
var previous_threat_distance := -1
var heartbeat_budget := 2


func configure(audio_source: Node, controller_source: Node) -> void:
	if audio != null and audio.cue_played.is_connected(_on_audio_cue):
		audio.cue_played.disconnect(_on_audio_cue)
	audio = audio_source
	controller = controller_source
	if audio != null and not audio.cue_played.is_connected(_on_audio_cue):
		audio.cue_played.connect(_on_audio_cue)


func emit_event(event: String, context: Dictionary = {}) -> bool:
	if not EVENTS.has(event):
		return false
	var definition: Dictionary = EVENTS[event]
	if event == "TURN_COMMITTED" and threat_active:
		# A new tactical decision earns fresh reminders, but does not bypass
		# the minimum interval between them.
		heartbeat_budget = 2
	event_emitted.emit(event, context)
	var sound := str(definition.get("audio", ""))
	if audio != null and not sound.is_empty() and not bool(context.get("audio_already_played", false)):
		playing_bus_audio = true
		audio.play(sound)
		playing_bus_audio = false
	var pattern := str(definition.get("haptic", ""))
	if controller != null and not pattern.is_empty() and controller.using_gamepad and controller.vibration_enabled and controller.vibration_intensity > 0.0:
		var haptic_context := context.duplicate()
		if audio != null and not sound.is_empty() and audio.has_method("get_haptic_envelope"):
			haptic_context["envelope"] = audio.get_haptic_envelope(sound)
		controller.feedback(pattern, false, -1, haptic_context)
	return true


func _on_audio_cue(cue: String) -> void:
	if not playing_bus_audio and AUDIO_EVENTS.has(cue):
		emit_event(str(AUDIO_EVENTS[cue]), {"audio_already_played": true})


func near_miss(context: Dictionary = {}) -> void:
	if near_miss_cooldown > 0.0:
		return
	near_miss_cooldown = 1.25
	emit_event("NEAR_MISS", context)


# At most one double heartbeat per interval, with a generous silent gap.
# A long frame never causes a burst of queued pulses. The visible/line-of-sight
# distance is supplied by the game, and the music keeps its existing mix.
# At rest, reminders stop after two double pulses until the next turn or a
# distance change, avoiding an indefinite vibration loop in a turn-based game.
func tick(delta: float, nearest_distance: int, active: bool, music_threat: float) -> void:
	var elapsed := maxf(0.0, delta)
	near_miss_cooldown = maxf(0.0, near_miss_cooldown - elapsed)
	if audio != null:
		audio.set_threat(music_threat)
	var danger := active and nearest_distance >= 0 and nearest_distance <= 4
	if not danger:
		if threat_active and controller != null:
			controller.cancel_feedback_category("threat")
		threat_active = false
		previous_threat_distance = -1
		heartbeat_cooldown = 0.0
		heartbeat_budget = 2
		return
	threat_active = true
	if nearest_distance != previous_threat_distance:
		heartbeat_budget = 2
		if previous_threat_distance < 0:
			heartbeat_cooldown = 0.0
		elif nearest_distance < previous_threat_distance:
			# Respond sooner to approach without flooding successive frames.
			heartbeat_cooldown = minf(heartbeat_cooldown, 0.42)
		previous_threat_distance = nearest_distance
	heartbeat_cooldown -= elapsed
	if heartbeat_cooldown <= 0.0 and heartbeat_budget > 0:
		var severity := clampf((4.0 - float(nearest_distance)) / 3.0, 0.0, 1.0)
		emit_event("ENEMY_NEAR", {"distance": nearest_distance, "gain": lerpf(0.40, 0.95, severity), "category": "threat"})
		heartbeat_cooldown = lerpf(1.55, 0.68, severity)
		heartbeat_budget -= 1
